# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trayloop

# Redis
REDIS_URL=redis://localhost:6379

# Stripe (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4.1-mini

# Email (choose one provider)
EMAIL_PROVIDER=resend
EMAIL_FROM=TrayLoop <noreply@yourdomain.com>

# Option A: Resend (https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# Option B: SMTP
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password

# Auth
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=7d

# Allowed browser origins for API access
MERCHANT_URL=https://dashboard.trayloophq.com
ADMIN_URL=https://master.trayloophq.com
STOREFRONT_URL=https://order.trayloophq.com
# Optional explicit comma-separated override for additional origins
# CORS_ALLOWED_ORIGINS=https://dashboard.trayloophq.com,https://master.trayloophq.com

# AWS
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789

# App
NODE_ENV=development
API_PORT=3001
API_URL=http://localhost:3001
