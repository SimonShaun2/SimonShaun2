{
  "name": "@trayloop/database",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "drizzle-kit generate --config=drizzle.config.js",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.js",
    "db:push": "drizzle-kit push --config=drizzle.config.js",
    "db:studio": "drizzle-kit studio --config=drizzle.config.js",
    "db:seed": "tsx src/seed.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.44.2",
    "postgres": "3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.1",
    "tsx": "4.19.4"
  }
}
